---
import "@/styles/global.css";
import { pagePath } from "@/docs/source";

interface Props {
  title: string;
  description?: string;
  /** Sidebar section, for the breadcrumb (`Library`, `Components`…). */
  section?: string;
  /** Pages with no canonical URL of their own (404). */
  noindex?: boolean;
  /** Whether a `.md` twin exists for this page. */
  markdown?: boolean;
}

const SITE_NAME = "ElementsKit";
const SITE_DESCRIPTION =
  "Universal reactive primitives for the web — signals, JSX, custom elements, and browser-API helpers.";

const { title, description = SITE_DESCRIPTION, section, noindex, markdown = true } = Astro.props;
const path = pagePath(Astro.url.pathname);
const isHome = path === "/";
// Home leads with brand + category; inner pages lead with their topic.
const documentTitle = isHome
  ? `${SITE_NAME}: Reactive primitives, JSX & custom elements`
  : `${title} | ${SITE_NAME}`;
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const software = {
  "@type": "SoftwareSourceCode",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  codeRepository: "https://github.com/elements-kit/elements-kit",
  programmingLanguage: "TypeScript",
  license: "https://opensource.org/licenses/MIT",
  author: {
    "@type": "Person",
    name: "Wael Bettayeb",
    url: "https://github.com/waelbettayeb",
  },
  url: Astro.site?.href,
  sameAs: [
    "https://github.com/elements-kit/elements-kit",
    "https://www.npmjs.com/package/elements-kit",
    "https://x.com/ElementsKit",
  ],
};

// Home describes the library; every other page is an article within it.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": isHome
    ? [software]
    : [
        {
          "@type": "TechArticle",
          headline: title,
          description,
          url: canonical.href,
          isPartOf: { "@type": "WebSite", name: SITE_NAME, url: Astro.site?.href },
          about: { "@type": "SoftwareSourceCode", name: SITE_NAME },
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: SITE_NAME, item: Astro.site?.href },
            ...(section ? [{ "@type": "ListItem", position: 2, name: section }] : []),
            { "@type": "ListItem", position: section ? 3 : 2, name: title, item: canonical.href },
          ],
        },
      ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before first paint: next-themes (inside the island) owns the `theme`
      // key afterwards; this only avoids a light flash on dark pages.
      (() => {
        let dark = matchMedia("(prefers-color-scheme: dark)").matches;
        try {
          // One-time carry-over of the Starlight preference.
          const legacy = localStorage.getItem("starlight-theme");
          if (legacy !== null) {
            if (localStorage.getItem("theme") === null)
              localStorage.setItem("theme", legacy === "auto" || !legacy ? "system" : legacy);
            localStorage.removeItem("starlight-theme");
          }
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") dark = saved === "dark";
        } catch {}
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {!noindex && markdown && <link rel="alternate" type="text/markdown" href={`${isHome ? "/index" : path}.md`} />}
    <meta name="theme-color" content="#007d58" />
    <meta name="author" content="Wael Bettayeb" />
    <meta
      name="keywords"
      content="signals, reactive, JSX, custom elements, web components, TypeScript, DOM, frontend, framework-agnostic, ElementsKit"
    />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:title" content={isHome ? documentTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ElementsKit" />
    <meta name="twitter:title" content={isHome ? documentTitle : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE_NAME} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
  </body>
</html>
