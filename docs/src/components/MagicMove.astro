---
interface Props {
  steps: string[];
  lang?: string;
  title?: string;
}
const { steps, lang = "tsx", title } = Astro.props;
---

<div
  class="magic-move-wrapper not-content"
  data-steps={JSON.stringify(steps)}
  data-lang={lang}
>
  <div class="magic-move-header">
    <span class="magic-move-lang">{title ?? lang}</span>
    <div class="magic-move-dots">
      {steps.map((_, i) => <span class="magic-move-dot" data-idx={i} />)}
    </div>
  </div>

  <div
    class="magic-move-code shiki-magic-move-container"
    style="padding: 0.75rem;"
  >
  </div>

  <div class="magic-move-footer">
    <button class="magic-move-btn prev" aria-label="Previous step" disabled>
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Prev
    </button>

    <span class="magic-move-counter">
      <span class="magic-move-current">1</span>
      <span class="magic-move-sep">/</span>
      <span class="magic-move-total">{steps.length}</span>
    </span>

    <button class="magic-move-btn next" aria-label="Next step">
      Next
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>

<script>
  // @ts-nocheck
  import { getSingletonHighlighter } from "shiki";
  import { codeToKeyedTokens } from "shiki-magic-move/core";
  import { MagicMoveRenderer } from "shiki-magic-move/renderer";

  const LIGHT_THEME = "github-light-default";
  const DARK_THEME = "github-dark-default";

  function currentTheme() {
    return document.documentElement.getAttribute("data-theme") === "light"
      ? LIGHT_THEME
      : DARK_THEME;
  }

  for (const wrapper of document.querySelectorAll(".magic-move-wrapper")) {
    const steps = JSON.parse(wrapper.dataset.steps ?? "[]");
    const lang = wrapper.dataset.lang ?? "tsx";

    const codeEl = wrapper.querySelector(".magic-move-code");
    const prevBtn = wrapper.querySelector(".prev");
    const nextBtn = wrapper.querySelector(".next");
    const currentEl = wrapper.querySelector(".magic-move-current");
    const dots = wrapper.querySelectorAll(".magic-move-dot");

    let stepIdx = 0;

    function updateUI() {
      currentEl.textContent = String(stepIdx + 1);
      prevBtn.disabled = stepIdx === 0;
      nextBtn.disabled = stepIdx === steps.length - 1;
      dots.forEach((dot, i) => dot.classList.toggle("active", i === stepIdx));
    }

    getSingletonHighlighter({
      langs: [lang],
      themes: [LIGHT_THEME, DARK_THEME],
    }).then((hl) => {
      const renderer = new MagicMoveRenderer(codeEl);
      renderer.options.duration = 400;
      renderer.options.stagger = 3;

      function buildTokens(theme) {
        return steps.map((s) => codeToKeyedTokens(hl, s, { lang, theme }));
      }

      let tokens = buildTokens(currentTheme());
      renderer.render(tokens[0]);
      updateUI();

      // Re-render on theme change without animation
      new MutationObserver(() => {
        tokens = buildTokens(currentTheme());
        renderer.render(tokens[stepIdx], { animate: false });
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      prevBtn.addEventListener("click", () => {
        if (stepIdx > 0) {
          stepIdx--;
          renderer.render(tokens[stepIdx]);
          updateUI();
        }
      });

      nextBtn.addEventListener("click", () => {
        if (stepIdx < steps.length - 1) {
          stepIdx++;
          renderer.render(tokens[stepIdx]);
          updateUI();
        }
      });

      // Keyboard navigation when wrapper is focused
      wrapper.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          e.preventDefault();
          if (stepIdx < steps.length - 1) {
            stepIdx++;
            renderer.render(tokens[stepIdx]);
            updateUI();
          }
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          e.preventDefault();
          if (stepIdx > 0) {
            stepIdx--;
            renderer.render(tokens[stepIdx]);
            updateUI();
          }
        }
      });
    });
  }
</script>

<style>
  .magic-move-wrapper {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    overflow: hidden;
    margin: 1.5rem 0;
    outline: none;
  }

  .magic-move-wrapper:focus-within {
    border-color: var(--sl-color-accent);
  }

  /* Header */
  .magic-move-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 1rem;
    background: var(--sl-color-gray-6);
    border-bottom: 1px solid var(--sl-color-gray-5);
    min-height: 2.25rem;
  }

  .magic-move-lang {
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .magic-move-dots {
    display: flex;
    gap: 0.375rem;
    align-items: center;
  }

  .magic-move-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sl-color-gray-4);
    transition: background 0.2s;
    cursor: default;
  }

  .magic-move-dot.active {
    background: var(--sl-color-accent);
  }

  /* Code area */
  .magic-move-code {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-code);
    line-height: 1.7;
  }

  .magic-move-code .shiki {
    background: transparent !important;
    padding: 1rem 1.25rem;
    margin: 0;
  }

  /* Footer */
  .magic-move-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.75rem;
    background: var(--sl-color-gray-6);
    border-top: 1px solid var(--sl-color-gray-5);
    gap: 0.75rem;
  }

  .magic-move-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.8rem;
    font-family: inherit;
    color: var(--sl-color-gray-2);
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.2rem;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background 0.15s;
    line-height: 1;
  }

  .magic-move-btn:hover:not(:disabled) {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-5);
  }

  .magic-move-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .magic-move-counter {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
    min-width: 3rem;
    text-align: center;
  }

  .magic-move-sep {
    margin: 0 0.15rem;
    opacity: 0.5;
  }
</style>
