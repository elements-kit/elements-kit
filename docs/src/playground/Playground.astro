---
import type { PlaygroundProps } from ".";

interface Props extends PlaygroundProps {}
const props = Astro.props;
const id = Math.random().toString(16).slice(2, 8);
---

<x-playground
  id={id}
  class="not-content"
  style={{
    paddingBlock: "1rem",
  }}></x-playground>

<script>
  import "./index";
</script>

<script define:vars={{ id, props }}>
  customElements.whenDefined("x-playground").then(() => {
    const el = document.getElementById(id);
    if (!el) return;
    Object.entries(props).forEach(([key, value]) => {
      if (value !== undefined) {
        el[key] = value;
      }
    });
  });
</script>
