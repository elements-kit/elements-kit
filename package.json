{
  "name": "elements-kit",
  "type": "module",
  "version": "0.0.14",
  "description": "A lightweight reactive UI library that transforms native HTMLElements into reactive components with signals. Ideal for framework-agnostic applications and web components.",
  "keywords": [
    "webcomponents",
    "custom-elements",
    "signals",
    "reactivity",
    "typescript",
    "library",
    "frontend",
    "builder",
    "html",
    "web"
  ],
  "author": "@waelbettayeb",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./signals": {
      "source": "./src/signals/index.ts",
      "import": "./dist/signals/index.mjs",
      "types": "./dist/signals/index.d.ts"
    },
    "./slot": {
      "source": "./src/slot.ts",
      "import": "./dist/slot.mjs",
      "types": "./dist/slot.d.ts"
    },
    "./attributes": {
      "source": "./src/attributes.ts",
      "import": "./dist/attributes.mjs",
      "types": "./dist/attributes.d.ts"
    },
    "./jsx-runtime": {
      "source": "./src/jsx-runtime/index.ts",
      "import": "./dist/jsx-runtime/index.mjs",
      "types": "./dist/jsx-runtime/index.d.ts"
    },
    "./jsx-dev-runtime": {
      "source": "./src/jsx-runtime/index.ts",
      "import": "./dist/jsx-runtime/index.mjs",
      "types": "./dist/jsx-runtime/index.d.ts"
    },
    "./integrations/*": {
      "source": "./src/integrations/*.ts",
      "import": "./dist/integrations/*.mjs",
      "types": "./dist/integrations/*.d.ts"
    },
    "./utilities/*": {
      "source": "./src/utilities/*.ts",
      "import": "./dist/utilities/*.mjs",
      "types": "./dist/utilities/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:docs": "pnpm build && pnpm --filter elements-kit-docs build",
    "watch": "tsdown -w",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.8.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "0.21.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "dom-expressions": "^0.40.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
